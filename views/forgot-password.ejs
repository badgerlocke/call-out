<%- include('partials/header-no-logo') -%>

<main class="container flex min-h-screen max-w-xl items-center px-4 py-10">
  <div class="card w-full border border-base-content/15 bg-base-100 shadow-xl">
    <section class="card-body">
      <h1 class="text-3xl font-bold">Reset your password</h1>
      <p class="text-base-content/70">
        Enter your account email. If it matches an account, we will send a link that expires in one hour.
      </p>

      <%- include('partials/flash-messages') -%>

      <form action="/forgot-password" method="POST" class="mt-2 space-y-4">
        <div>
          <label for="email" class="label-text">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            class="input input-bordered mt-1 w-full"
            autocomplete="email"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary w-full">Send reset link</button>
      </form>

      <a href="/login" class="link link-primary mt-2 text-center">Back to login</a>
    </section>
  </div>
</main>

<%- include('partials/footer') -%>
