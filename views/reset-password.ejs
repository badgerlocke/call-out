<%- include('partials/header-no-logo') -%>

<main class="container flex min-h-screen max-w-xl items-center px-4 py-10">
  <div class="card w-full border border-base-content/15 bg-base-100 shadow-xl">
    <section class="card-body">
      <h1 class="text-3xl font-bold">Choose a new password</h1>

      <%- include('partials/flash-messages') -%>

      <form action="/reset-password/<%= token %>" method="POST" class="mt-2 space-y-4">
        <div>
          <label for="password" class="label-text">New password</label>
          <input
            id="password"
            name="password"
            type="password"
            class="input input-bordered mt-1 w-full"
            minlength="8"
            autocomplete="new-password"
            data-password
            required
          />
          <p class="mt-1 text-sm text-base-content/60">At least 8 characters</p>
        </div>
        <div>
          <label for="confirmPassword" class="label-text">Confirm new password</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            class="input input-bordered mt-1 w-full"
            minlength="8"
            autocomplete="new-password"
            data-password
            required
          />
          <label class="label cursor-pointer justify-start gap-2 py-1">
            <input type="checkbox" class="checkbox checkbox-sm" data-show-password />
            <span class="label-text">Show passwords</span>
          </label>
        </div>
        <button type="submit" class="btn btn-primary w-full">Reset password</button>
      </form>
    </section>
  </div>
</main>

<script src="/js/show-password.js"></script>
<%- include('partials/footer') -%>
