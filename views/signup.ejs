<%- include('partials/header') -%>

<main class="container max-w-xl px-4 py-10">
  <div class="card border border-base-content/15 bg-base-100 shadow-xl">
    <section class="card-body">
      <h1 class="mb-2 text-3xl font-bold">Create your account</h1>
      <p class="mb-4 text-base-content/70">Start planning trips with just the essentials.</p>

      <form action="/signup" method="POST" class="space-y-4">
        <div>
          <label for="realName" class="label-text">Name</label>
          <input
            type="text"
            class="input input-bordered w-full"
            id="realName"
            name="realName"
            autocomplete="name"
            required
          />
        </div>
        <div>
          <label for="email" class="label-text">Email address</label>
          <input
            type="email"
            class="input input-bordered w-full"
            id="email"
            name="email"
            autocomplete="email"
            required
          />
        </div>
        <div>
          <label for="password" class="label-text">Password</label>
          <input
            type="password"
            class="input input-bordered w-full"
            id="password"
            name="password"
            autocomplete="new-password"
            minlength="8"
            data-password
            required
          />
          <div class="label-text-alt mt-1 text-base-content/60">At least 8 characters</div>
        </div>
        <div>
          <label for="confirmPassword" class="label-text">Confirm password</label>
          <input
            type="password"
            class="input input-bordered w-full"
            id="confirmPassword"
            name="confirmPassword"
            autocomplete="new-password"
            minlength="8"
            data-password
            required
          />
          <label class="label cursor-pointer justify-start gap-2 py-1">
            <input type="checkbox" class="checkbox checkbox-sm" data-show-password />
            <span class="label-text">Show passwords</span>
          </label>
        </div>
        <button type="submit" class="btn btn-primary w-full">Create account</button>
      </form>

      <p class="mt-6 text-center">
        Already have an account?
        <a href="/login" class="link link-primary font-semibold">Log in</a>
      </p>
    </section>
  </div>
</main>

<script src="/js/show-password.js"></script>

<%- include('partials/footer') -%>