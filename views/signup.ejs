<%- include('partials/header') -%>
    <main class="container max-w-2xl px-4 py-10">
        <div class="">
            <section class="">
                <% if (locals.messages.errors) { %>
                    <% messages.errors.forEach( el => { %>
                        <div class="alert alert-error"><%= el.msg %></div>
                    <% }) %>    
                <% } %>
                <% if (locals.messages.info) { %>
                    <% messages.info.forEach( el => { %>
                        <div class="alert alert-info"><%= el.msg %></div>
                    <% }) %>    
                <% } %>
                <h1 class="mb-6 text-3xl font-bold">Create your account</h1>
                <form action="/signup" method="POST" class="space-y-4">
                    <div class="">
                        <label for="realName" class="label-text">Your name</label>
                        <input type="text" class="input input-bordered w-full" id="realName" aria-describedby="real-name" name="realName">
                        <!-- <div id="real-name" class="label-text-alt text-base-content/60">The name you go by</div> -->
                    </div>
                    <div class="">
                        <label for="userName" class="label-text">Username</label>
                        <input type="text" class="input input-bordered w-full" id="userName" name="userName">
                    </div>
                    <!-- TODO - uncomment when code is implemented to handle profile pics -->
                    <!-- <div class="mb-3">
                      <label for="profilePic" class="label-text">Picture of your cat</label>
                      <input type="file" class="file-input file-input-bordered w-full" id="profilePic" name="file">
                      <div id="emailHelp" class="label-text-alt text-base-content/60">This will be your profile pic.</div>
                    </div> -->
                    <div class="">
                      <label for="exampleInputEmail1" class="label-text">Email address</label>
                      <input type="email" class="input input-bordered w-full" id="exampleInputEmail1" aria-describedby="emailHelp" name="email">
                      <div id="emailHelp" class="label-text-alt text-base-content/60">We'll never share your email with anyone else.</div>
                    </div>
                    <div class="">
                      <label for="password" class="label-text">Password</label>
                      <input type="password" class="input input-bordered w-full" id="password" name="password">
                    </div>
                    <div class="">
                        <label for="confirmPassword" class="label-text">Confirm Password</label>
                        <input type="password" class="input input-bordered w-full" id="confirmPassword" name="confirmPassword">
                    </div>

                    <h2 class="pt-4 text-xl font-bold">Optional information</h2>
                    <div class="">
                        <label for="age" class="label-text">Age</label>
                        <input type="number" class="input input-bordered w-full" id="age" name="age">
                    </div>
                    <div class="">
                        <label for="profilePic" class="label-text">Profile picture</label>
                        <input type="file" class="file-input file-input-bordered w-full" id="profilePic" aria-describedby="pic" name="profilePic">
                        <div id="pic" class="label-text-alt text-base-content/60">Please provide a recent picture of yourself. Aside from serving as your profile picture, this can help identify you if a search is ever necessary.</div>
                    </div>
                    <div class="">
                        <label for="location" class="label-text">Location</label>
                        <input type="text" class="input input-bordered w-full" id="location" aria-describedby="location-desc" name="location">
                        <div id="location-desc" class="label-text-alt text-base-content/60">Zip code or city, state (optional)</div>
                        <!-- Todo: allow zip code or city, state lookup -->
                    </div>
                    <div class="">
                        <label for="bio" class="label-text">Bio</label>
                        <textarea class="textarea textarea-bordered w-full" id="bio" aria-describedby="bio-desc" name="bio"></textarea>
                        <div id="bio-desc" class="label-text-alt text-base-content/60">Tell us a bit about yourself (optional)</div>
                    </div>

                    <div class="">
                        <label for="phoneNumber" class="label-text">Phone number</label>
                        <input type="tel" class="input input-bordered w-full" id="phoneNumber" aria-describedby="phone" name="phoneNumber">
                        <div id="phone" class="label-text-alt text-base-content/60"></div>
                    </div>
                    <h2 class="pt-4 text-xl font-bold">Emergency contact</h2>
                    <div class="">
                        <label for="contactName" class="label-text">Emergency contact name</label>
                        <input type="text" class="input input-bordered w-full" id="contactName" name="contactName">
                    </div>
                    <div class="">
                        <label for="contactEmail" class="label-text">Emergency contact email</label>
                        <input type="email" class="input input-bordered w-full" id="contactEmail" name="contactEmail">
                    </div>
                    <div class="">
                        <label for="contactPhone" class="label-text">Emergency phone number</label>
                        <input type="tel" class="input input-bordered w-full" id="contactPhone" name="contactPhone">
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                  </form>
            </section>
        </div>
    </main>

<%- include('partials/footer') -%>