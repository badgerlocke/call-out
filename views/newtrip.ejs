<%- include('partials/header') -%>

<main class="container">
  <div>
    <section class="">

    <h1>New Trip</h1>
    <form action="/trips/createTrip" method="POST" id="newTripForm">
      <!-- Location -->
      <label class="label">
        <span class="label-text">Where are you going?</span>
      </label>
      <input type="text" class="input input-bordered input-primary w-full max-w-xs" id="location" name="location">
      <!-- Details -->
      <label class="label">
        <span class="label-text">Details</span>
      </label>
      <textarea
        class="textarea textarea-bordered w-3/4"
        id="details" name="details"></textarea>
      <!-- Expected return -->
      <div class="form-control">
        <label class="label" for="returnDate">
          <span class="label-text">When do you expect to return?</span>
        </label>
        <div class="flex flex-wrap gap-2">
          <input type="date" class="input input-bordered" id="returnDate" name="returnDate" required>
          <input type="time" class="input input-bordered" id="returnTimeOfDay" name="returnTimeOfDay" required>
        </div>
        <!-- Filled in on submit with the exact instant, in the browser's time zone -->
        <input type="hidden" id="returnTime" name="returnTime">
      </div>
      <!-- Checkbox for notification -->
      <div class="form-control">
        <label class="label w-fit cursor-pointer justify-start gap-3">
          <input
            type="checkbox"
            checked
            class="checkbox checkbox-primary"
            id="notify" name="notify" value="true">
          <span class="label-text">Notify my contacts if I don't check in</span>
        </label>
      </div>
      <!-- Call out window -->
      <div class="form-control" id="notifyFields">
        <label class="label" for="notifyOffsetValue">
          <span class="label-text"
            >How long after your expected return time should we notify your
            emergency contacts?</span
          >
        </label>
        <label class="input-group">
          <input
            type="number" min="1" step="1" value="2"
            class="input input-bordered w-24"
            id="notifyOffsetValue" name="notifyOffsetValue" required>
          <select class="select select-bordered" id="notifyOffsetUnit" name="notifyOffsetUnit">
            <option value="minutes">Minutes</option>
            <option value="hours" selected>Hours</option>
            <option value="days">Days</option>
          </select>
        </label>
        <label class="label">
          <span class="label-text-alt" id="notifyPreview"></span>
        </label>
      </div>
      <!-- Select trip type -->
      <div class="form-control w-full max-w-xs">
        <label class="label">
          <span class="label-text">What kind of trip are you going on?</span>
        </label>
        <select class="select select-bordered" id="tripType" name="tripType">
          <option disabled selected>Pick one</option>
          <option>Hiking</option>
          <option>Camping</option>
          <option>Backpacking</option>
          <option>Climbing</option>
          <option>Caving</option>
          <option>Other</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
    </section>
</div>
</main>
<script src="/js/newtrip.js"></script>