<%- include('partials/header') -%>
<%
  const activeTrips = trips.filter(trip => !trip.checkedIn);
  const completedTrips = trips.filter(trip => trip.checkedIn);
  const formatDate = date => new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium',
    timeStyle: 'short'
  }).format(new Date(date));
%>

<main class="bkg bkg-bridge min-h-[calc(100vh-4rem)] px-4 py-8 sm:px-6 sm:py-12">
  <div class="container max-w-6xl">
    <section class="rounded-3xl border border-white/20 bg-base-100/90 p-5 shadow-2xl backdrop-blur-md sm:p-8">
      <div class="flex flex-col gap-5 border-b border-base-300 pb-7 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-primary">
            <% const firstName = user.realName ? user.realName.split(' ')[0] : ''; %>
            Welcome back<% if (firstName) { %>, <%= firstName %><% } %>
          </p>
          <h1 class="text-3xl font-bold sm:text-4xl">My trips</h1>
          <p class="mt-2 max-w-2xl text-base-content/70">
            Keep your plans current and check in when you return safely.
          </p>
        </div>
        <% if (trips.length > 0) { %>
          <a href="/trips/newtrip" class="btn btn-primary js-open-new-trip">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Create a trip
          </a>
        <% } %>
      </div>

      <% if (trips.length === 0) { %>
        <div class="mx-auto flex max-w-xl flex-col items-center py-14 text-center sm:py-20">
          <div class="mb-6 grid h-20 w-20 place-items-center rounded-full bg-primary/15 text-3xl text-primary">
            <span aria-hidden="true">🧭</span>
          </div>
          <h2 class="text-2xl font-bold">No trips planned yet</h2>
          <p class="mt-3 text-base-content/70">
            Create a trip and set a return time so your emergency contacts can be notified if you do not check in.
          </p>
          <a href="/trips/newtrip" class="btn btn-primary btn-lg mt-7 js-open-new-trip">
            Plan your first trip
          </a>
        </div>
      <% } else { %>
        <section class="py-8" aria-labelledby="active-trips-heading">
          <div class="mb-5 flex items-center justify-between">
            <h2 id="active-trips-heading" class="text-2xl font-bold">Active trips</h2>
            <span class="badge badge-primary badge-outline"><%= activeTrips.length %> active</span>
          </div>

          <% if (activeTrips.length === 0) { %>
            <div class="rounded-2xl border border-dashed border-base-content/25 bg-base-200/60 p-8 text-center">
              <p class="font-semibold">You are safely checked in.</p>
              <p class="mt-1 text-sm text-base-content/60">Start a new trip whenever you are heading out again.</p>
            </div>
          <% } else { %>
            <div class="grid gap-5 lg:grid-cols-2">
              <% activeTrips.forEach(trip => { const isOverdue = new Date(trip.returnTime) < new Date(); %>
                <article class="card border <%= isOverdue ? 'border-error/60 bg-error/10' : 'border-primary/40 bg-base-200/80' %> shadow-lg">
                  <div class="card-body">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <span class="badge <%= isOverdue ? 'badge-error' : 'badge-primary' %> mb-3">
                          <%= isOverdue ? 'Overdue' : 'Active' %>
                        </span>
                        <h3 class="card-title text-2xl"><%= trip.location %></h3>
                      </div>
                      <div class="flex flex-col items-end gap-2">
                        <span class="badge badge-outline"><%= trip.tripType || 'Trip' %></span>
                        <span class="badge <%= trip.visibility === 'friends' ? 'badge-info' : 'badge-ghost' %>">
                          <%= trip.visibility === 'friends' ? 'Friends' : 'Private' %>
                        </span>
                      </div>
                    </div>
                    <div class="mt-2 flex items-start gap-3">
                      <i class="far fa-clock mt-1 text-primary" aria-hidden="true"></i>
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Expected return</p>
                        <p class="font-semibold"><%= formatDate(trip.returnTime) %></p>
                      </div>
                    </div>
                    <% if (trip.details) { %>
                      <p class="mt-2 text-base-content/70"><%= trip.details %></p>
                    <% } %>
                    <div class="card-actions mt-4 items-center justify-between">
                      <div class="flex flex-wrap gap-1">
                        <form action="/trips/deleteTrip/<%= trip.id %>?_method=DELETE" method="POST">
                          <button class="btn btn-ghost btn-sm text-error" type="submit" aria-label="Delete trip to <%= trip.location %>">
                            <i class="fas fa-trash" aria-hidden="true"></i>
                            Delete
                          </button>
                        </form>
                        <% if (trip.visibility === 'friends') { %>
                          <form action="/trips/<%= trip.id %>/visibility?_method=PUT" method="POST">
                            <input type="hidden" name="visibility" value="private">
                            <button class="btn btn-ghost btn-sm" type="submit">Hide</button>
                          </form>
                        <% } else { %>
                          <form action="/trips/<%= trip.id %>/visibility?_method=PUT" method="POST" data-confirm="Share this trip with friends? They will see your location, return time, and check-in status.">
                            <input type="hidden" name="visibility" value="friends">
                            <button class="btn btn-ghost btn-sm" type="submit">Share with friends</button>
                          </form>
                        <% } %>
                      </div>
                      <form action="/trips/checkIn/<%= trip.id %>?_method=PUT" method="POST">
                        <button class="btn btn-success" type="submit">
                          <i class="fas fa-check" aria-hidden="true"></i>
                          Check in safely
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>

        <% if (completedTrips.length > 0) { %>
          <section class="border-t border-base-300 pt-8" aria-labelledby="completed-trips-heading">
            <h2 id="completed-trips-heading" class="mb-5 text-xl font-bold">Past trips</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              <% completedTrips.forEach(trip => { %>
                <article class="flex items-center justify-between gap-4 rounded-xl bg-base-200/70 p-4">
                  <div class="min-w-0">
                    <h3 class="truncate font-bold"><%= trip.location %></h3>
                    <p class="text-sm text-base-content/60">
                      <%= trip.tripType || 'Trip' %> · Returned by <%= formatDate(trip.returnTime) %>
                      · <%= trip.visibility === 'friends' ? 'Friends' : 'Private' %>
                    </p>
                  </div>
                  <div class="flex shrink-0 items-center gap-1">
                    <span class="badge badge-success badge-outline hidden sm:inline-flex">
                      <i class="fas fa-check mr-1" aria-hidden="true"></i>
                      Checked in
                    </span>
                    <% if (trip.visibility === 'friends') { %>
                      <form action="/trips/<%= trip.id %>/visibility?_method=PUT" method="POST">
                        <input type="hidden" name="visibility" value="private">
                        <button class="btn btn-ghost btn-sm" type="submit">Hide</button>
                      </form>
                    <% } else { %>
                      <form action="/trips/<%= trip.id %>/visibility?_method=PUT" method="POST" data-confirm="Share this trip with friends? They will see your location, return time, and check-in status.">
                        <input type="hidden" name="visibility" value="friends">
                        <button class="btn btn-ghost btn-sm" type="submit">Share</button>
                      </form>
                    <% } %>
                    <form action="/trips/deleteTrip/<%= trip.id %>?_method=DELETE" method="POST">
                      <button class="btn btn-ghost btn-sm btn-circle text-error" type="submit" aria-label="Delete trip to <%= trip.location %>">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                      </button>
                    </form>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        <% } %>
      <% } %>
    </section>
  </div>
</main>

<script src="/js/confirm-submit.js"></script>
<%- include('partials/footer') -%>